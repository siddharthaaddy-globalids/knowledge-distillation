#!/usr/bin/env bash
# ===========================================================================
#  Self-contained knowledge-distillation runner
#
#  Built by GitHub Actions from __REPO__@__SHA_SHORT__ on __BUILT_AT__
#
#  QUICK START
#    chmod +x distill.sh
#    ./distill.sh --teacher HuggingFaceTB/SmolLM2-1.7B-Instruct
#
#  Bootstraps uv, fetches the pinned source, detects your hardware
#  (Apple Silicon MPS / CUDA / CPU) and runs the distillation.
#  Run ./distill.sh --help for all options.
# ===========================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
#  Defaults. Override with CLI flags (preferred) or KD_* environment variables.
#  Precedence: CLI flag  >  KD_* env var  >  these defaults.
# ---------------------------------------------------------------------------
# IMPORTANT: empty means "not specified", and the selected profile's YAML value is used.
# These must NOT carry hardcoded model defaults: they are exported as KD_* variables,
# which outrank the config file, so a non-empty default here would silently override
# whatever the profile specifies (e.g. clobbering configs/finance.yaml with SmolLM2).
# A KD_* variable set by the caller still counts as an explicit choice.
TEACHER_MODEL="${KD_TEACHER_MODEL:-}"
STUDENT_MODEL="${KD_STUDENT_MODEL:-}"
TEACHER_ADAPTER="${KD_TEACHER_ADAPTER:-}"
DATASET="${KD_DATASET:-}"

DEVICE="${KD_DEVICE:-}"              # auto | cpu | mps | cuda
DTYPE="${KD_DTYPE:-}"                # auto | float32 | bfloat16 | float16
MAX_STEPS="${KD_MAX_STEPS:-}"
OUTPUT_DIR="${KD_OUTPUT_DIR:-}"

BATCH_SIZE="${KD_BATCH_SIZE:-}"      # blank = profile default
GRAD_ACCUM="${KD_GRAD_ACCUM:-}"
LEARNING_RATE="${KD_LEARNING_RATE:-}"
LORA_R="${KD_LORA_R:-}"
LORA_ALPHA="${KD_LORA_ALPHA:-}"
LMBDA="${KD_LMBDA:-}"

CONFIG_PROFILE=""                    # blank = auto (Apple Silicon -> mac)
PROFILE_EXPLICIT=0                   # 1 once --profile is given on the CLI
MODE="train"

UI_PORT="${KD_UI_PORT:-7860}"
UI_HOST="${KD_UI_HOST:-127.0.0.1}"
UI_SHARE=0
ADAPTER_DIR="${KD_ADAPTER_PATH:-}"

REPO_URL="__REPO_URL__"
REPO_REF="__SHA__"
WORKDIR="${KD_WORKDIR:-$HOME/.cache/kd-runner}"
SRC_DIR="$WORKDIR/src"

# Plain text only: ANSI escapes do not survive every terminal, pipe, CI log or
# `tee`, and a banner that renders as raw escape codes is worse than no colour.
RULE='=============================================================================='

log()  { printf '==> %s\n' "$*"; }
warn() { printf '!!  %s\n' "$*" >&2; }
die()  { printf 'xx  %s\n' "$*" >&2; exit 1; }

# Indented detail lines under a banner.
ok()   { printf '%s\n' "$*"; }
bad()  { printf '%s\n' "$*" >&2; }

banner_ok() {
  echo
  echo "$RULE"
  echo "  ALL OK - $1"
  echo "$RULE"
}

banner_bad() {
  echo >&2
  echo "$RULE" >&2
  echo "  FAILED - $1" >&2
  echo "$RULE" >&2
}

# Pull " <key>  : <value>" out of a --print-config block.
field() {
  printf '%s\n' "$1" | awk -F': ' -v k="$2" '$0 ~ "^ "k" +:" {print $2; exit}'
}

# ---------------------------------------------------------------------------
#  Help
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
distill.sh - knowledge distillation runner (pinned to __SHA_SHORT__)

USAGE
  ./distill.sh [OPTIONS]

MODELS AND DATA
  -t, --teacher MODEL     Teacher model id or local path
                          (default: from the selected profile)
  -s, --student MODEL     Student model id or local path
      --teacher-adapter P LoRA adapter merged into the teacher at load time.
                          Use when the teacher is a base model plus an adapter
                          rather than a merged checkpoint - merged exports from
                          other frameworks often keep that framework's key
                          layout, which plain transformers may not map back.
                          Accepts a HF repo id or a local directory.
                          (default: from the selected profile)
  -d, --dataset NAME      Training dataset
                          (default: from the selected profile)

  NOTE: teacher and student must share a tokenizer vocabulary for standard GKD.

HARDWARE
      --device DEV        auto | cpu | mps | cuda   (default: from profile)
                          auto detects Apple Silicon (MPS) and CUDA
      --dtype TYPE        auto | float32 | bfloat16 | float16  (default: from profile)
                          bfloat16 on MPS requires macOS 14.0 or newer

TRAINING
      --steps N           Optimizer steps (default: from profile)
      --batch-size N      Per-device batch size
      --grad-accum N      Gradient accumulation steps
      --lr RATE           Learning rate (e.g. 3e-4)
      --lora-r N          LoRA rank
      --lora-alpha N      LoRA alpha
      --lmbda F           On-policy fraction 0.0-1.0; raise toward 1.0 for
                          more student rollouts corrected by the teacher
  -o, --output DIR        Output directory (default: from profile)
  -p, --profile NAME      Config profile:
                            default | mac | smoke | finance | qwen-poc
                          (default: auto-selected from platform)
                          qwen-poc = Qwen3.5-2B -> Qwen3.5-0.8B on finance-alpaca.
                          A known-good pairing for proving the pipeline; pair it
                          with --dtype bfloat16 to halve the memory footprint.

MODES
      --check             Resolve config and hardware, print, and exit.
                          Run this first - it is instant and catches typos.
      --check-teacher     Load ONLY the teacher and verify it is fit to distil
                          from: missing/randomly-initialised weights, NaN scan,
                          and whether its output is actually language.
                          A broken teacher yields a broken student, because GKD
                          trains the student to match the teacher's distribution.
      --fix-teacher       Repair a merged checkpoint whose tensor keys do not
                          match its architecture, by renaming them to what the
                          model asks for. No retraining and no GPU. Writes a
                          repaired copy and prints the --teacher flag to use.
      --smoke             2-step end-to-end validation (~1 min)
      --ui                Launch the side-by-side comparison web UI
                          (original vs distilled vs teacher) instead of training
      --shell             Open a shell with the environment activated
  -h, --help              Show this help
  -V, --version           Show the pinned build revision

UI OPTIONS (with --ui)
      --port N            Port to serve on (default: 7860)
      --host ADDR         Bind address (default: 127.0.0.1)
      --share             Create a public Gradio share link
      --adapter DIR       Compare a specific adapter directory
                          (default: the newest one found under --output)

EXAMPLES
  # See what would run, without running it
  ./distill.sh --check

  # Verify the teacher before spending a training budget on it
  ./distill.sh --profile finance --check-teacher

  # Teacher failed --check-teacher because its keys are mislabelled? Repair it
  ./distill.sh --profile finance --fix-teacher

  # Known-good proof-of-concept run, in bfloat16 to fit comfortably in 16GB
  ./distill.sh --profile qwen-poc --dtype bfloat16

  # Teacher as base + LoRA adapter, instead of a merged checkpoint
  ./distill.sh --teacher Qwen/Qwen3.5-2B --teacher-adapter ./lora_model

  # Bigger teacher - the single highest-leverage change
  ./distill.sh --teacher HuggingFaceTB/SmolLM2-1.7B-Instruct

  # Retarget everything
  ./distill.sh -t Qwen/Qwen2.5-1.5B-Instruct -s Qwen/Qwen2.5-0.5B-Instruct \\
               -d HuggingFaceTB/smoltalk --steps 600

  # More on-policy rollouts, longer run, explicit output
  ./distill.sh --lmbda 0.9 --steps 600 -o ./run-lmbda09

  # Force CPU on a Mac (slow, for comparison)
  ./distill.sh --device cpu --steps 50

  # Train, then inspect the result in the browser
  ./distill.sh --teacher HuggingFaceTB/SmolLM2-1.7B-Instruct
  ./distill.sh --ui

  # Serve the UI on the LAN so others can try it
  ./distill.sh --ui --host 0.0.0.0 --port 8080

ENVIRONMENT
  Every flag has a KD_* equivalent, applied when the flag is absent:
    KD_TEACHER_MODEL  KD_STUDENT_MODEL  KD_DATASET  KD_DEVICE  KD_DTYPE
    KD_TEACHER_ADAPTER
    KD_MAX_STEPS      KD_BATCH_SIZE     KD_GRAD_ACCUM         KD_LEARNING_RATE
    KD_LORA_R         KD_LORA_ALPHA     KD_LMBDA              KD_OUTPUT_DIR
  KD_WORKDIR sets the checkout cache (default: \$HOME/.cache/kd-runner)

OUTPUT
  The trained LoRA adapter is written to <output>/final_adapter
EOF
}

# ---------------------------------------------------------------------------
#  Argument parsing. Supports both "--flag value" and "--flag=value".
# ---------------------------------------------------------------------------
need_val() {
  # $1 = flag name, $2 = count of remaining args
  [ "$2" -ge 2 ] || die "Option $1 requires a value. See --help."
}

while [ $# -gt 0 ]; do
  case "$1" in
    -t|--teacher)     need_val "$1" $#; TEACHER_MODEL="$2"; shift 2 ;;
    --teacher=*)      TEACHER_MODEL="${1#*=}"; shift ;;
    -s|--student)     need_val "$1" $#; STUDENT_MODEL="$2"; shift 2 ;;
    --teacher-adapter) need_val "$1" $#; TEACHER_ADAPTER="$2"; shift 2 ;;
    --teacher-adapter=*) TEACHER_ADAPTER="${1#*=}"; shift ;;
    --student=*)      STUDENT_MODEL="${1#*=}"; shift ;;
    -d|--dataset)     need_val "$1" $#; DATASET="$2"; shift 2 ;;
    --dataset=*)      DATASET="${1#*=}"; shift ;;

    --device)         need_val "$1" $#; DEVICE="$2"; shift 2 ;;
    --device=*)       DEVICE="${1#*=}"; shift ;;
    --dtype)          need_val "$1" $#; DTYPE="$2"; shift 2 ;;
    --dtype=*)        DTYPE="${1#*=}"; shift ;;

    --steps)          need_val "$1" $#; MAX_STEPS="$2"; shift 2 ;;
    --steps=*)        MAX_STEPS="${1#*=}"; shift ;;
    --batch-size)     need_val "$1" $#; BATCH_SIZE="$2"; shift 2 ;;
    --batch-size=*)   BATCH_SIZE="${1#*=}"; shift ;;
    --grad-accum)     need_val "$1" $#; GRAD_ACCUM="$2"; shift 2 ;;
    --grad-accum=*)   GRAD_ACCUM="${1#*=}"; shift ;;
    --lr)             need_val "$1" $#; LEARNING_RATE="$2"; shift 2 ;;
    --lr=*)           LEARNING_RATE="${1#*=}"; shift ;;
    --lora-r)         need_val "$1" $#; LORA_R="$2"; shift 2 ;;
    --lora-r=*)       LORA_R="${1#*=}"; shift ;;
    --lora-alpha)     need_val "$1" $#; LORA_ALPHA="$2"; shift 2 ;;
    --lora-alpha=*)   LORA_ALPHA="${1#*=}"; shift ;;
    --lmbda)          need_val "$1" $#; LMBDA="$2"; shift 2 ;;
    --lmbda=*)        LMBDA="${1#*=}"; shift ;;

    -o|--output)      need_val "$1" $#; OUTPUT_DIR="$2"; shift 2 ;;
    --output=*)       OUTPUT_DIR="${1#*=}"; shift ;;
    -p|--profile)     need_val "$1" $#; CONFIG_PROFILE="$2"; PROFILE_EXPLICIT=1; shift 2 ;;
    --profile=*)      CONFIG_PROFILE="${1#*=}"; PROFILE_EXPLICIT=1; shift ;;

    --port)           need_val "$1" $#; UI_PORT="$2"; shift 2 ;;
    --port=*)         UI_PORT="${1#*=}"; shift ;;
    --host)           need_val "$1" $#; UI_HOST="$2"; shift 2 ;;
    --host=*)         UI_HOST="${1#*=}"; shift ;;
    --share)          UI_SHARE=1; shift ;;
    --adapter)        need_val "$1" $#; ADAPTER_DIR="$2"; shift 2 ;;
    --adapter=*)      ADAPTER_DIR="${1#*=}"; shift ;;

    --check)          MODE="check"; shift ;;
    --check-teacher)  MODE="check-teacher"; shift ;;
    --fix-teacher)    MODE="fix-teacher"; shift ;;
    --smoke)          MODE="smoke"; shift ;;
    --ui)             MODE="ui"; shift ;;
    --shell)          MODE="shell"; shift ;;
    -h|--help)        usage; exit 0 ;;
    -V|--version)     echo "distill.sh pinned to __REPO__@__SHA_SHORT__ (built __BUILT_AT__)"; exit 0 ;;

    --) shift; break ;;
    -*) die "Unknown option: $1  (run --help)" ;;
    *)  die "Unexpected argument: $1  (run --help)" ;;
  esac
done

# ---------------------------------------------------------------------------
#  Validate
# ---------------------------------------------------------------------------
# An empty value means "inherit from the profile", so it is always valid.
case "$DEVICE" in ''|auto|cpu|mps|cuda) ;; *) die "--device must be auto|cpu|mps|cuda (got '$DEVICE')" ;; esac
case "$DTYPE"  in ''|auto|float32|bfloat16|float16) ;; *) die "--dtype must be auto|float32|bfloat16|float16 (got '$DTYPE')" ;; esac
[ -n "$MAX_STEPS" ] && case "$MAX_STEPS" in *[!0-9]*) die "--steps must be a positive integer (got '$MAX_STEPS')" ;; esac
case "$UI_PORT"  in ''|*[!0-9]*) die "--port must be a positive integer (got '$UI_PORT')" ;; esac
[ -n "$CONFIG_PROFILE" ] && case "$CONFIG_PROFILE" in
  default|mac|smoke|finance|qwen-poc) ;; *) die "--profile must be default|mac|smoke|finance|qwen-poc (got '$CONFIG_PROFILE')" ;;
esac

# ---------------------------------------------------------------------------
#  1. Platform detection
# ---------------------------------------------------------------------------
OS="$(uname -s)"
ARCH="$(uname -m)"
IS_APPLE_SILICON=0
if [ "$OS" = "Darwin" ] && [ "$ARCH" = "arm64" ]; then
  IS_APPLE_SILICON=1
fi

log "Platform: $OS/$ARCH"
if [ "$IS_APPLE_SILICON" -eq 1 ]; then
  MACOS_VER="$(sw_vers -productVersion 2>/dev/null || echo unknown)"
  TOTAL_RAM_GB="$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"
  log "Apple Silicon detected - macOS $MACOS_VER, ${TOTAL_RAM_GB}GB unified memory"
  # transformers only permits bfloat16 on MPS from macOS 14.0 onward.
  MACOS_MAJOR="${MACOS_VER%%.*}"
  if [ "$DTYPE" = "bfloat16" ] && [ "${MACOS_MAJOR:-0}" -lt 14 ] 2>/dev/null; then
    warn "bfloat16 needs macOS >= 14.0; the pipeline will fall back to float32."
  fi
  # Let the MPS allocator use the whole unified pool rather than a fraction of it.
  export PYTORCH_MPS_HIGH_WATERMARK_RATIO="${PYTORCH_MPS_HIGH_WATERMARK_RATIO:-0.0}"
  export PYTORCH_ENABLE_MPS_FALLBACK="${PYTORCH_ENABLE_MPS_FALLBACK:-1}"
fi

if [ -z "$CONFIG_PROFILE" ]; then
  if [ "$IS_APPLE_SILICON" -eq 1 ]; then CONFIG_PROFILE="mac"; else CONFIG_PROFILE="default"; fi
fi
# --smoke defaults to the tiny smoke profile, but ONLY when no profile was asked
# for. Overriding an explicit --profile would measure a different model pair than
# the one about to be trained, making the projected run time meaningless.
if [ "$MODE" = "smoke" ] && [ "$PROFILE_EXPLICIT" -eq 0 ]; then
  CONFIG_PROFILE="smoke"
fi
log "Config profile: $CONFIG_PROFILE"

# ---------------------------------------------------------------------------
#  2. uv bootstrap
# ---------------------------------------------------------------------------
if ! command -v uv >/dev/null 2>&1; then
  log "uv not found - installing to ~/.local/bin"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
fi
command -v uv >/dev/null 2>&1 || die "uv install failed. See https://docs.astral.sh/uv/"
log "uv $(uv --version 2>/dev/null | awk '{print $2}')"

# ---------------------------------------------------------------------------
#  3. Fetch pinned source
# ---------------------------------------------------------------------------
mkdir -p "$WORKDIR"
if [ -d "$SRC_DIR/.git" ]; then
  log "Updating source in $SRC_DIR"
  git -C "$SRC_DIR" fetch --depth 1 origin "$REPO_REF" 2>/dev/null || git -C "$SRC_DIR" fetch origin
  git -C "$SRC_DIR" checkout -q "$REPO_REF"
else
  log "Cloning $REPO_URL @ ${REPO_REF:0:12}"
  rm -rf "$SRC_DIR"
  git clone --quiet "$REPO_URL" "$SRC_DIR"
  git -C "$SRC_DIR" checkout -q "$REPO_REF"
fi
cd "$SRC_DIR"

# ---------------------------------------------------------------------------
#  4. Environment
# ---------------------------------------------------------------------------
log "Syncing dependencies (first run downloads torch - this takes a while)"
uv sync --quiet || die "uv sync failed"

# ---------------------------------------------------------------------------
#  5. Hand the resolved settings to the pipeline as KD_* overrides
# ---------------------------------------------------------------------------
# Export ONLY what was explicitly requested. Anything left empty falls through to the
# profile's YAML value - exporting a default here would override the config file.
[ -n "$TEACHER_MODEL" ] && export KD_TEACHER_MODEL="$TEACHER_MODEL"
[ -n "$STUDENT_MODEL" ] && export KD_STUDENT_MODEL="$STUDENT_MODEL"
[ -n "$TEACHER_ADAPTER" ] && export KD_TEACHER_ADAPTER="$TEACHER_ADAPTER"
[ -n "$DATASET" ]       && export KD_DATASET="$DATASET"
[ -n "$DEVICE" ]        && export KD_DEVICE="$DEVICE"
[ -n "$DTYPE" ]         && export KD_DTYPE="$DTYPE"
[ -n "$OUTPUT_DIR" ]    && export KD_OUTPUT_DIR="$OUTPUT_DIR"
[ -n "$MAX_STEPS" ]     && export KD_MAX_STEPS="$MAX_STEPS"
[ -n "$BATCH_SIZE" ]    && export KD_BATCH_SIZE="$BATCH_SIZE"
[ -n "$GRAD_ACCUM" ]    && export KD_GRAD_ACCUM="$GRAD_ACCUM"
[ -n "$LEARNING_RATE" ] && export KD_LEARNING_RATE="$LEARNING_RATE"
[ -n "$LORA_R" ]        && export KD_LORA_R="$LORA_R"
[ -n "$LORA_ALPHA" ]    && export KD_LORA_ALPHA="$LORA_ALPHA"
[ -n "$LMBDA" ]         && export KD_LMBDA="$LMBDA"

CONFIG_FILE="configs/${CONFIG_PROFILE}.yaml"
[ -f "$CONFIG_FILE" ] || die "Config profile not found: $CONFIG_FILE"

# ---------------------------------------------------------------------------
#  6. Run
# ---------------------------------------------------------------------------
case "$MODE" in
  check)
    log "Resolving configuration (no training)"
    set +e
    CHECK_OUT="$(uv run python train_scaled.py --config "$CONFIG_FILE" --print-config 2>&1)"
    CHECK_RC=$?
    set -e
    printf '%s
' "$CHECK_OUT"
    if [ $CHECK_RC -ne 0 ]; then
      banner_bad "configuration did not resolve (exit $CHECK_RC)"
      exit $CHECK_RC
    fi
    C_DEV="$(field "$CHECK_OUT" device)"
    C_TCH="$(field "$CHECK_OUT" teacher)"
    C_STU="$(field "$CHECK_OUT" student)"
    C_DS="$(field "$CHECK_OUT" dataset)"
    banner_ok "configuration resolved"
    ok "   profile : $CONFIG_PROFILE"
    ok "   teacher : $C_TCH"
    ok "   student : $C_STU"
    ok "   dataset : $C_DS"
    ok "   device  : $C_DEV"
    case "$C_DEV" in
      mps*)  ok "   Apple GPU (MPS) in use." ;;
      cuda*) ok "   CUDA GPU in use." ;;
      cpu*)  [ "$IS_APPLE_SILICON" -eq 1 ]                && warn "Running on CPU despite Apple Silicon - MPS was not detected."                || ok "   Running on CPU." ;;
    esac
    echo
    ok "   Next: ./distill.sh --profile $CONFIG_PROFILE --check-teacher"
    echo
    ;;
  fix-teacher)
    # The repaired copy lives beside the checkout so it survives across runs and
    # is addressable by absolute path from anywhere.
    FIXED_DIR="$WORKDIR/teacher-fixed"
    log "Repairing the teacher checkpoint into $FIXED_DIR"
    log "  (renames tensors to match the architecture; no retraining, no GPU)"
    set +e
    uv run python fix_teacher.py --config "$CONFIG_FILE" --out "$FIXED_DIR" --force
    FIX_RC=$?
    set -e
    if [ "$FIX_RC" -ne 0 ]; then
      banner_bad "could not repair the checkpoint (exit $FIX_RC)"
      bad "   The weights may genuinely be incomplete rather than mislabelled."
      bad "   If you still have the LoRA adapter from training, use it instead:"
      bad "     ./distill.sh --teacher <base-model> --teacher-adapter <adapter> --check-teacher"
      exit "$FIX_RC"
    fi
    banner_ok "teacher checkpoint repaired"
    ok "   output : $FIXED_DIR"
    echo
    ok "   Verify it, then train against it:"
    ok "     ./distill.sh --profile $CONFIG_PROFILE --teacher $FIXED_DIR --check-teacher"
    ok "     ./distill.sh --profile $CONFIG_PROFILE --teacher $FIXED_DIR"
    echo
    ;;
  check-teacher)
    log "Verifying the teacher (loads the teacher only, not the student)"
    CT_ARGS="--config $CONFIG_FILE"
    [ -n "$DTYPE" ] && CT_ARGS="$CT_ARGS --dtype $DTYPE"
    [ -n "$DEVICE" ] && CT_ARGS="$CT_ARGS --device $DEVICE"
    set +e
    # shellcheck disable=SC2086  # CT_ARGS is intentionally word-split into flags
    uv run python check_teacher.py $CT_ARGS
    CT_RC=$?
    set -e
    if [ "$CT_RC" -ne 0 ]; then
      banner_bad "teacher is not fit to distil from (exit $CT_RC)"
      bad "   Distilling from it would produce a broken student."
      bad "   If the weights are present but mislabelled, repair them:"
      bad "     ./distill.sh --profile $CONFIG_PROFILE --fix-teacher"
      bad "   If the teacher was trained as a LoRA adapter, point at the base model"
      bad "   and merge the adapter instead of using a merged export:"
      bad "     ./distill.sh --teacher <base> --teacher-adapter <adapter> --check-teacher"
      exit "$CT_RC"
    fi
    banner_ok "teacher is fit to distil from"
    ok "   profile : $CONFIG_PROFILE"
    ok "   All weights loaded, no NaN/Inf, output is coherent language."
    echo
    ok "   Next: ./distill.sh --profile $CONFIG_PROFILE --smoke"
    echo
    ;;
  ui)
    # Default to the adapter this runner would have written, so --ui right after a
    # training run just works. app.py falls back to its own search if it is absent.
    # With no explicit --output, let app.py discover the newest adapter itself.
    [ -z "$ADAPTER_DIR" ] && [ -n "$OUTPUT_DIR" ] && ADAPTER_DIR="${OUTPUT_DIR}/final_adapter"
    UI_ARGS="--host $UI_HOST --port $UI_PORT --config $CONFIG_FILE"
    [ -n "$TEACHER_MODEL" ] && UI_ARGS="$UI_ARGS --teacher $TEACHER_MODEL"
    [ -n "$STUDENT_MODEL" ] && UI_ARGS="$UI_ARGS --student $STUDENT_MODEL"
    [ -n "$ADAPTER_DIR" ] && [ -d "$ADAPTER_DIR" ] && UI_ARGS="$UI_ARGS --adapter $ADAPTER_DIR"
    [ "$UI_SHARE" -eq 1 ] && UI_ARGS="$UI_ARGS --share"
    log "Launching comparison UI on http://$UI_HOST:$UI_PORT"
    log "  adapter : ${ADAPTER_DIR:-(auto-discovered)}"
    log "  (loads three models - first start takes a minute; Ctrl+C to stop)"
    # shellcheck disable=SC2086  # UI_ARGS is intentionally word-split into flags
    uv run python app.py $UI_ARGS
    ;;
  shell)
    log "Entering a shell with the environment active. Exit to return."
    exec uv run "${SHELL:-bash}"
    ;;
  smoke)
    log "Smoke test - 2 steps end to end"
    set +e
    SMOKE_LOG="$(mktemp -t kd-smoke.XXXXXX)"
    uv run python train_scaled.py --config "$CONFIG_FILE" --dry-run 2>&1 | tee "$SMOKE_LOG"
    SMOKE_RC=${PIPESTATUS[0]}
    set -e
    if [ "$SMOKE_RC" -ne 0 ]; then
      banner_bad "smoke test did not complete (exit $SMOKE_RC)"
      rm -f "$SMOKE_LOG"
      exit "$SMOKE_RC"
    fi
    S_PARAMS="$(grep -m1 'trainable params' "$SMOKE_LOG" || true)"
    S_STEP="$(grep -o '[0-9.]\+s/step' "$SMOKE_LOG" | tail -1 || true)"
    S_EVAL="$(grep -o 'held-out loss = [0-9.]\+' "$SMOKE_LOG" | tail -1 || true)"
    S_TRAIN="$(grep -c '^ \[step' "$SMOKE_LOG" || true)"
    rm -f "$SMOKE_LOG"
    banner_ok "pipeline runs end to end"
    ok "   profile        : $CONFIG_PROFILE"
    [ -n "$S_PARAMS" ] && ok "   ${S_PARAMS# }"
    ok "   training steps : ${S_TRAIN:-0} completed"
    [ -n "$S_EVAL" ] && ok "   $S_EVAL"
    if [ -n "$S_STEP" ]; then
      ok "   speed          : $S_STEP"
      SPS="${S_STEP%s/step}"
      EST="$(awk -v s="$SPS" -v n="${MAX_STEPS:-300}" 'BEGIN{printf "%d", s*n/60}' 2>/dev/null || echo '')"
      [ -n "$EST" ] && ok "   est. full run  : ~${EST} min for ${MAX_STEPS:-300} steps"
    fi
    echo
    ok "   Next: ./distill.sh --profile $CONFIG_PROFILE"
    echo
    ;;
  train)
    log "Starting distillation"
    log "  profile : $CONFIG_PROFILE"
    log "  teacher : ${TEACHER_MODEL:-(from profile)}"
    log "  student : ${STUDENT_MODEL:-(from profile)}"
    log "  dataset : ${DATASET:-(from profile)}"
    log "  steps   : ${MAX_STEPS:-(from profile)}"
    set +e
    uv run python train_scaled.py --config "$CONFIG_FILE"
    TRAIN_RC=$?
    set -e
    if [ "$TRAIN_RC" -ne 0 ]; then
      banner_bad "training did not complete (exit $TRAIN_RC)"
      exit "$TRAIN_RC"
    fi
    # OUTPUT_DIR may be empty (inherited from the profile), so resolve it for the banner.
    RESOLVED_OUT="$OUTPUT_DIR"
    [ -z "$RESOLVED_OUT" ] && RESOLVED_OUT="$(field         "$(uv run python train_scaled.py --config "$CONFIG_FILE" --print-config 2>/dev/null)" output)"
    ABS_OUT="$SRC_DIR/${RESOLVED_OUT#./}"
    banner_ok "training complete"
    ok "   adapter : $ABS_OUT/final_adapter"
    echo
    ok "   Next: ./distill.sh --profile $CONFIG_PROFILE --ui"
    echo
    ;;
esac
