#!/usr/bin/env bash
# ===========================================================================
#  Knowledge-distillation runner
#
#  Built by GitHub Actions from __REPO__@__SHA_SHORT__ on __BUILT_AT__
#
#  QUICK START
#    chmod +x distill.sh
#    ./distill.sh --config configs/finance.yaml
#
#  This script is a bootstrapper and nothing else. It installs uv, fetches the
#  source pinned to the commit it was built from, and hands over to the Python
#  pipeline. Everything the pipeline does - stage order, gating, limits, the
#  config precedence chain - lives in the source, so this file and its
#  PowerShell twin cannot drift from each other or from the code.
#
#  Anything it does not recognise is passed straight through:
#
#    ./distill.sh --config configs/finance.yaml --set training.max_steps=500
#    ./distill.sh evaluate --config configs/finance.yaml
#    ./distill.sh --help
#
#  With no leading subcommand it runs the full gated pipeline.
# ===========================================================================
set -euo pipefail

REPO_URL="__REPO_URL__"
REPO_REF="__SHA__"
BUILD_REF="__REPO__@__SHA_SHORT__"
BUILT_AT="__BUILT_AT__"

WORKDIR="${KD_WORKDIR:-$HOME/.cache/kd-runner}"
USE_LOCAL="${KD_LOCAL:-0}"

# Optional dependency groups to install alongside the core ones. Empty by default,
# because the core install is already large and neither group is needed for a
# plain training run. KD_EXTRAS holds a space-separated list of names.
EXTRAS=""
for _extra in ${KD_EXTRAS:-}; do
  EXTRAS="$EXTRAS --extra $_extra"
done

# Plain text only: ANSI escapes do not survive every terminal, pipe, CI log or
# `tee`, and a banner that renders as raw escape codes is worse than no colour.
log()  { printf '==> %s\n' "$*"; }
die()  { printf 'xx  %s\n' "$*" >&2; exit 1; }

runner_help() {
  cat <<'EOF'
distill.sh - bootstrapper for the knowledge-distillation pipeline

  ./distill.sh [RUNNER OPTIONS] [COMMAND] [PIPELINE OPTIONS]

RUNNER OPTIONS (consumed here; everything else is passed through)
  --runner-help       This message. Use --help for the pipeline's own help.
  --runner-version    The commit this runner was built from.
  --local             Use the checkout this script sits in, instead of fetching
                      the pinned source. For working on the pipeline itself.
  --extra NAME        Install an optional dependency group, repeatable:
                        eval    benchmark tasks and generation similarity
                        remote  S3 and RunPod
                      Neither is needed for a plain training run.
  --workdir DIR       Where to keep the checkout (default: ~/.cache/kd-runner,
                      or $KD_WORKDIR).

COMMAND
  Omitted, or any option starting with "-", runs the full gated pipeline.
  Otherwise the first argument is the pipeline subcommand: train, evaluate,
  check, check-teacher, fix-teacher, convert-adapter, publish, ui, doctor.

EXAMPLES
  ./distill.sh --config configs/finance.yaml
  ./distill.sh --config configs/finance.yaml --set training.max_steps=500
  ./distill.sh --config configs/finance.yaml --only train
  ./distill.sh check --config configs/finance.yaml
  ./distill.sh doctor
  ./distill.sh --help

  Run `./distill.sh --help` for every pipeline option.
EOF
}

# ---------------------------------------------------------------------------
#  1. Split the runner's own flags from everything else
# ---------------------------------------------------------------------------
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --runner-help)    runner_help; exit 0 ;;
    --runner-version) echo "distill.sh pinned to $BUILD_REF (built $BUILT_AT)"; exit 0 ;;
    --local)          USE_LOCAL=1; shift ;;
    --extra)          [ $# -ge 2 ] || die "--extra needs a name: eval or remote"
                      EXTRAS="$EXTRAS --extra $2"; shift 2 ;;
    --extra=*)        EXTRAS="$EXTRAS --extra ${1#*=}"; shift ;;
    --workdir)        [ $# -ge 2 ] || die "--workdir needs a directory"
                      WORKDIR="$2"; shift 2 ;;
    --workdir=*)      WORKDIR="${1#*=}"; shift ;;
    *)                ARGS+=("$1"); shift ;;
  esac
done

# With no arguments at all, or when the first one is an option, the intent is a
# full pipeline run. Deciding on the leading "-" rather than on a list of known
# subcommands means this file never has to be updated when one is added.
if [ "${#ARGS[@]}" -eq 0 ] || [ "${ARGS[0]#-}" != "${ARGS[0]}" ]; then
  ARGS=("pipeline" "${ARGS[@]+"${ARGS[@]}"}")
fi

# Print the command that would run, and stop. The only decision this script makes
# on its own is which pipeline command to invoke, and this is what lets that be
# tested - in CI and by hand - without a clone, a torch download or a GPU.
if [ "${KD_DISPATCH_ONLY:-0}" = "1" ]; then
  printf '%s\n' "${ARGS[*]}"
  exit 0
fi

SRC_DIR="$WORKDIR/src"

# ---------------------------------------------------------------------------
#  2. Platform
# ---------------------------------------------------------------------------
OS="$(uname -s)"
ARCH="$(uname -m)"
log "Platform: $OS/$ARCH"

if [ "$OS" = "Darwin" ] && [ "$ARCH" = "arm64" ]; then
  # Let the MPS allocator use the whole unified memory pool rather than a
  # fraction of it, and route unsupported ops to CPU instead of raising.
  export PYTORCH_MPS_HIGH_WATERMARK_RATIO="${PYTORCH_MPS_HIGH_WATERMARK_RATIO:-0.0}"
  export PYTORCH_ENABLE_MPS_FALLBACK="${PYTORCH_ENABLE_MPS_FALLBACK:-1}"
fi

# ---------------------------------------------------------------------------
#  3. uv
# ---------------------------------------------------------------------------
if ! command -v uv >/dev/null 2>&1; then
  log "uv not found - installing to ~/.local/bin"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
fi
command -v uv >/dev/null 2>&1 || die "uv install failed. See https://docs.astral.sh/uv/"

# ---------------------------------------------------------------------------
#  4. Source
# ---------------------------------------------------------------------------
if [ "$USE_LOCAL" = "1" ]; then
  SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
  # A runner is normally downloaded on its own, so --local is only meaningful
  # from inside a checkout. Saying so beats a later import error.
  [ -f "$SRC_DIR/pyproject.toml" ] || die \
    "--local needs this script to sit in a checkout; no pyproject.toml in $SRC_DIR"
  log "Using local checkout: $SRC_DIR"
else
  mkdir -p "$WORKDIR"
  if [ -d "$SRC_DIR/.git" ]; then
    log "Updating source in $SRC_DIR"
    git -C "$SRC_DIR" fetch --depth 1 origin "$REPO_REF" 2>/dev/null \
      || git -C "$SRC_DIR" fetch origin
    git -C "$SRC_DIR" checkout -q "$REPO_REF"
  else
    log "Cloning $REPO_URL @ ${REPO_REF:0:12}"
    rm -rf "$SRC_DIR"
    git clone --quiet "$REPO_URL" "$SRC_DIR"
    git -C "$SRC_DIR" checkout -q "$REPO_REF"
  fi
fi
cd "$SRC_DIR"

# ---------------------------------------------------------------------------
#  5. Environment
# ---------------------------------------------------------------------------
log "Syncing dependencies (the first run downloads torch - this takes a while)"
[ -n "$EXTRAS" ] && log "  extras:$EXTRAS"
# shellcheck disable=SC2086  # EXTRAS is intentionally word-split into flag pairs
uv sync --quiet $EXTRAS || die "uv sync failed"

# ---------------------------------------------------------------------------
#  6. Hand over
# ---------------------------------------------------------------------------
# `python -m kd` rather than the `kd` console script: the module form needs
# nothing on PATH and no generated executable, which is what makes it work
# identically inside a container, in CI, and on a Windows machine whose security
# software distrusts freshly written binaries.
exec uv run python -m kd "${ARGS[@]}"
