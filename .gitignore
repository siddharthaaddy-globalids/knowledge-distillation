# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Virtual environments (uv)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
# NOTE: uv.lock and .python-version are intentionally NOT ignored - they pin the
# environment and belong in version control for reproducible installs.

# ---------------------------------------------------------------------------
# Trained model artifacts
# ---------------------------------------------------------------------------
# Training checkpoints carry full optimizer state (~116 MB each) and are pure
# resumable scratch - never commit these.
distilled_smollm_poc/checkpoint-*/
distilled_smollm_scaled/checkpoint-*/

# Final LoRA adapters (~20 MB and ~39 MB). Ignored by default to keep the repo a
# code repo and avoid permanent git history bloat. Regenerate with:
#     kd train --config configs/default.yaml
# To ship an adapter instead, delete the lines below and track it with
# Git LFS:  git lfs track "*.safetensors"
distilled_smollm_poc/
distilled_smollm_scaled/
distilled_smollm_mac/
distilled_smollm_smoke/
distilled_output/

# lm-evaluation-harness output, written by `kd evaluate --tasks`. Regenerate with:
#     kd evaluate --config configs/default.yaml --tasks ifeval
/evals/

# Rendered runners - generated by .github/workflows/build-runner.yml from
# scripts/distill.{sh,ps1}.template. The templates are tracked; the rendered
# files are build output, pinned to a commit, and downloaded rather than committed.
/distill.sh
/distill.ps1

# Loose weight files anywhere in the tree
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx

# ---------------------------------------------------------------------------
# Hugging Face / datasets caches
# ---------------------------------------------------------------------------
.cache/
hf_cache/
wandb/
outputs/

# ---------------------------------------------------------------------------
# Run bundles
# ---------------------------------------------------------------------------
# One directory per run, holding its resolved config, logs, events, metrics,
# report and adapter. Everything a run produces is here and nothing else in the
# tree is written to, so this single rule covers all of it.
runs/
# The 'latest' pointer, whichever form the platform allowed.
latest.txt

# ---------------------------------------------------------------------------
# Gradio
# ---------------------------------------------------------------------------
.gradio/
flagged/
gradio_cached_examples/

# ---------------------------------------------------------------------------
# Secrets and local config
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------------------
# Logs / scratch
# ---------------------------------------------------------------------------
*.log
nohup.out
scratch/
tmp/

# Prepared training corpora, written by scripts/prepare_curriculum.py. Ignored by
# default: they are generated, and most are far too large to commit.
#
# The enLibra curriculum is the deliberate exception. It is 3.4 MB, the converter
# is deterministic - the same exports always produce the same bytes - and a pod is
# a fresh `git clone`, so committing it is what puts the corpus on the pod without
# a download and without credentials.
data/*
!data/enlibra-curriculum/
