# Line endings.
#
# Git normalises text files to LF in the repository and checks them out with the
# platform's convention. That is right for source, and wrong for anything a Unix
# shell has to execute: a shell script checked out with CRLF fails on Linux with
# "bad interpreter: /usr/bin/env bash^M", which is an obscure way to learn that
# the file was edited on Windows.
#
# The runner is generated on Linux by CI and run on Linux, macOS and inside the
# container, so it is pinned to LF everywhere. distill.ps1 is pinned to CRLF
# because that is what Windows PowerShell expects.

* text=auto

*.sh            text eol=lf
*.sh.template   text eol=lf
*.bash          text eol=lf
Dockerfile*     text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf

*.ps1           text eol=crlf
*.ps1.template  text eol=crlf

# Model weights and tokenizer blobs: binary, never diffed or normalised.
*.safetensors   binary
*.pt            binary
*.pth           binary
*.bin           binary
